# exclude in vendor derectory
/vendor
/script/tmp/*
!/script/tmp/.dummy
#exclude .DS_Store
**/.DS_Store
._*
**/._*
*.bak
*.prev
*_bak.*
*-old.php
* copy*

# editor settings
/.vscode/
/.idea/

# local configuration, copy from settings/settings.php.example*
/settings.php

# operator-supplied third-party tags (e.g. the CMP tag, see cmp_script)
/public/js/local/

# operator-supplied skin assets and coin artwork: logos, favicons, side-menu
# backgrounds, copied stylesheets. Never commit these (CONTRIBUTING rule 6), and
# keeping them out of the tracked defaults also stops a pull from conflicting.
/public/img/local/
/public/css/local/

# loader output when cron redirects it (docs/installation.md section 11)
/script/*.log

# Playwright MCP scratch output (snapshots, console logs) from local debugging
.playwright-mcp/
